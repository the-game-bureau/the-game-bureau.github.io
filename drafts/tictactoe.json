{"v":1,"by":"the-game-bureau","isNew":true,"start":"studio/starter","at":1795836294119,"game":{"kit":"notebook","layout":"product","slug":"tictactoe","title":"Galaxy 608","kicker":"The Game Bureau presents","brand":{"color":"#3D4F5C","accent":"#7FD1AE","paper":"#F7F9F9","ink":"#151C21"},"tagline":"One sentence that says what the game is and why it's fun.","shareText":"Let's play Tic-Tac-Toe!","announce":"","price":"$9.99","currency":"USD","order":{"url":"","label":"ORDER PRINTED NOTEBOOK","shippingNote":"Shipping calculated at checkout."},"media":[{"type":"image","src":"/studio/assets/placeholder-game-notebook.webp","alt":"Placeholder game notebook","placeholder":true},{"type":"image","src":"/studio/assets/placeholder-open.webp","alt":"Placeholder open","placeholder":true},{"type":"image","src":"/studio/assets/placeholder-with-pencil.webp","alt":"Placeholder with pencil","placeholder":true},{"type":"video","src":"/studio/assets/notebook-open.mp4","alt":"Placeholder video","placeholder":true}],"aboutHeading":"What it is","description":["Two or three short paragraphs about the game: who plays, what you do, and what makes it fun."],"specs":[["PLAYERS","2 to 6"],["TIME","About 30 minutes"],["YOU NEED","A pencil"]],"stepsHeading":"How it works","steps":[{"title":"Set up","text":"What players do before the game starts."},{"title":"Play","text":"What happens on each turn or round."},{"title":"Win","text":"How the game ends and who wins."}],"videoHeading":"See it played","rulesBlurb":"Everything you need to play, on one page. The same rules are printed inside the notebook.","setup":{},"print":{"trim":[8.5,11],"bleed":0.125,"margin":0.5,"spinePerPage":0.002252,"padTo":2,"sheets":72,"author":"The Game Bureau"},"subtitle":"You are lost in space!","slugTouched":true},"rules":"<h1>{{title}} rules</h1>\n\n<p>You need this notebook and a pencil. Play with 2 to 6 players.</p>\n\n<h2>Setup</h2>\n\n<ol>\n  <li><strong>First step.</strong> Say what players do before the first round.</li>\n  <li><strong>Second step.</strong> Keep each step short.</li>\n</ol>\n\n<h2>Playing a round</h2>\n\n<ol>\n  <li><strong>Do this.</strong> One idea per step.</li>\n  <li><strong>Then this.</strong> Bold the name of the step.</li>\n  <li><strong>Score it.</strong> Say where in the notebook the score is written.</li>\n</ol>\n\n<h2>Winning</h2>\n\n<p>Say how the game ends and who wins.</p>\n\n<aside class=\"callout\"><p><strong>Tip.</strong> A box like this calls out an example or an exception.</p></aside>\n","cover":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"robots\" content=\"noindex\">\n<title>Cover</title>\n<link rel=\"stylesheet\" href=\"/studio/kit/print.css?v=9ba110c193\">\n<script src=\"/studio/kit/kit.js?v=9ba110c193\"></script>\n<script src=\"/studio/kit/print.js?v=9ba110c193\"></script>\n<!--\n  COVER (Big photo style, from the studio's cover styles). Design the front and the back here; print.js places them:\n    ?layout=spread  back | spine | front, with bleed (the printer's cover PDF)\n    ?layout=front   front alone at trim size (first page of the print-at-home and sampler PDFs; the sampler adds its stamp on top)\n    ?layout=back    back alone at trim size (last page of those PDFs)\n  .cover-front and .cover-back fill their panel to the bleed edge, with padding set for you so\n  words stay in the safe area. Pictures may run to the bleed; words never leave the padding.\n  Filled from game.json: {{title}} {{subtitle}} {{tagline}} {{kicker}} {{url}} {{price}},\n  and as HTML: {{steps}} {{specs}} {{description}} {{image}} {{qr}} {{stepsHeading}}\n  ({{image}} is the photo marked FOR NOTEBOOK COVER in Media, or a pattern of squares when none is).\n  Colours: var(--brand) var(--accent) var(--paper) var(--ink), plus var(--on-brand) and var(--on-accent)\n  (white or ink, whichever reads on that colour) and var(--brand-ink) (the main colour, or ink when it is too pale on paper).\n  Type on every style: kicker 10pt Text caps, title in Display caps, subtitle 24pt Display caps, web address 9pt.\n-->\n<style>\n/* Front: the photo fills the whole front to the bleed; the words sit on a dark fade at the bottom. */\n.cover-front .kick{font:800 10pt/1.2 \"NB Text\",sans-serif;letter-spacing:.3em;text-transform:uppercase}\n.cover-front h1{line-height:.9;text-transform:uppercase;text-wrap:balance;overflow-wrap:break-word}\n.cover-front .sub{font:400 24pt/1.05 \"NB Display\",Impact,sans-serif;letter-spacing:.1em;text-transform:uppercase;text-wrap:balance}\n.cover-front .kick:empty,.cover-front .sub:empty{display:none}\n.cover-front .pk-url{font:700 9pt/1.2 \"NB Text\",sans-serif;letter-spacing:.06em;margin-top:auto;padding-top:12pt;opacity:.85}\n.cover-front{background:var(--brand);color:#fff;justify-content:flex-end;overflow:hidden}\n.cover-front .pk-image{position:absolute;inset:0;width:100%;height:100%;max-height:none;margin:0;border-radius:0;object-fit:cover}\n.cover-front .pk-art{position:absolute;right:var(--pad);top:var(--pad);opacity:.5}\n.cover-front::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:60%;background:linear-gradient(to top,rgba(0,0,0,.85) 15%,rgba(0,0,0,0))}\n.cover-front>:not(.pk-image):not(.pk-art){position:relative;z-index:1}\n.cover-front .words{text-shadow:0 1pt 6pt rgba(0,0,0,.35)}\n.cover-front .kick{color:var(--accent)}\n.cover-front h1{font-size:84pt;margin-top:10pt;max-width:7in}\n.cover-front .sub{margin-top:12pt}\n.cover-front .pk-url{margin-top:0;padding-top:.3in}\n\n/* BACK: \"Poster\". The main colour to the bleed, photo 1 echoed faintly behind so the wrap\n   reads as one piece, then, sitting at the bottom just above the footer, the kicker, the title, the hook in the accent\n   colour and the tagline, and a footer band with a QR code to the game page, \"Scan for updates and other game notebooks\" and the address. */\n.cover-back{background:var(--brand);color:var(--on-brand);overflow:hidden;gap:0}\n.cover-back .bk-echo{position:absolute;left:0;right:0;top:0;bottom:0;overflow:hidden;z-index:0}\n.cover-back .bk-echo .pk-image{position:absolute;inset:0;width:100%;height:100%;max-height:none;margin:0;border-radius:0;object-fit:cover;filter:grayscale(1) contrast(1.15);mix-blend-mode:luminosity;opacity:.28}\n.cover-back .bk-echo .pk-art{display:none}\n.cover-back .bk-echo::after{content:\"\";position:absolute;inset:0;background:linear-gradient(to bottom,color-mix(in srgb,var(--brand) 20%,transparent) 30%,var(--brand) 92%)}\n.cover-back>*:not(.bk-echo){position:relative;z-index:1}\n.cover-back .bk-kick{margin-top:auto;font:800 10pt/1.2 \"NB Text\",sans-serif;letter-spacing:.3em;text-transform:uppercase;color:color-mix(in srgb,var(--on-brand) 80%,transparent)}\n.cover-back .bk-kick:empty{display:none}\n.cover-back .bk-title{font:400 92pt/.9 \"NB Display\",Impact,sans-serif;letter-spacing:.01em;text-transform:uppercase;margin-top:10pt;max-width:7in;text-wrap:balance}\n.cover-back h2{font-size:40pt;line-height:.95;text-transform:uppercase;color:var(--accent);margin-top:14pt;max-width:6.6in;text-wrap:balance}\n.cover-back h2:empty{display:none}\n.cover-back .bk-tag{font:500 15pt/1.4 \"NB Text\",sans-serif;margin:16pt 0 0;max-width:6in}\n.cover-back .bk-tag:empty{display:none}\n.cover-back .bk-foot{margin:.4in calc(-1 * var(--pad)) calc(-1 * var(--pad));padding:.22in var(--pad) var(--pad);background:var(--paper);color:var(--ink);display:flex;align-items:flex-end;gap:14pt}\n.cover-back .pk-qr{width:1.05in;height:1.05in;color:var(--ink);flex:none}\n.cover-back .bk-scan{font:400 10pt/1.35 \"NB Text\",sans-serif;flex:1;align-self:center}\n.cover-back .bk-scan b{display:block;font:400 17pt/1 \"NB Display\",Impact,sans-serif;letter-spacing:.03em;color:var(--brand-ink);margin-bottom:4pt;text-transform:uppercase}\n.cover-back .bk-url{display:block;font:800 12pt/1.2 \"NB Text\",sans-serif;letter-spacing:.02em}\n</style>\n</head>\n<body data-page=\"cover\">\n\n<div class=\"cover-front\">\n  {{image}}\n  <div class=\"words\">\n    <div class=\"kick\">{{kicker}}</div>\n    <h1>{{title}}</h1>\n    <div class=\"sub\">{{subtitle}}</div>\n  </div>\n</div>\n\n<div class=\"cover-spine\">{{title}}</div>\n\n<div class=\"cover-back\">\n  <div class=\"bk-echo\">{{image}}</div>\n  <div class=\"bk-kick\">{{kicker}}</div>\n  <div class=\"bk-title\">{{title}}</div>\n  <h2>{{subtitle}}</h2>\n  <p class=\"bk-tag\">{{tagline}}</p>\n  <div class=\"bk-foot\">\n    {{qr}}\n    <div class=\"bk-scan\"><b>Scan for updates and other game notebooks</b><span class=\"bk-url\">{{url}}</span></div>\n  </div>\n</div>\n\n</body>\n</html>\n","contents":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"robots\" content=\"noindex\">\n<title>Contents</title>\n<link rel=\"stylesheet\" href=\"/studio/kit/print.css\">\n<script src=\"/studio/kit/kit.js\"></script>\n<script src=\"/studio/kit/print.js\"></script>\n<!--\n  CONTENTS: every inside page of the notebook, in order.\n  - <section data-rules> is replaced by rules.md and flows onto as many pages as it needs.\n  - Each <section class=\"page\"> is one fixed page; its padding keeps content in the safe area.\n  - <template data-repeat=\"N\" data-per=\"2\"> repeats its pages N times. Inside it, {{n}} numbers\n    the copies (1, 2, 3...) and {{i}} {{i+1}} number the items on each copy (1-2, 3-4...).\n    {{sheets}} is print.sheets in game.json (set on the admin page).\n  - Filled from game.json: {{title}} {{subtitle}} {{tagline}} {{url}} {{price}} {{sheets}}.\n-->\n<style>\n.page h2{font-size:28pt;color:var(--brand)}\n.page .lede{margin:4pt 0 12pt;font-size:10pt}\n.grid{width:100%;border-collapse:collapse;table-layout:fixed}\n.grid th,.grid td{border:1pt solid var(--ink);height:.3in;font-size:9pt;text-align:center}\n.grid thead th{background:var(--brand);color:#fff;font:400 11pt \"NB Display\",Impact,sans-serif;letter-spacing:.04em;height:.42in}\n.grid th.r{width:.7in;background:color-mix(in srgb,var(--accent) 25%,#fff);color:var(--ink);font:400 11pt \"NB Display\",Impact,sans-serif}\n.grid tfoot th,.grid tfoot td{height:.42in;border-width:2pt}\n\n.sheet{display:flex;flex-direction:column;gap:10pt}\n.sheet-head{display:flex;justify-content:space-between;align-items:baseline;border-bottom:2pt solid var(--ink);padding-bottom:4pt}\n.sheet-head .fill{display:flex;gap:16pt;font:800 8pt \"NB Text\",sans-serif;letter-spacing:.1em}\n.sheet-head .fill span{border-bottom:1pt solid var(--ink);min-width:1.3in}\n.notes{flex:1;border:1pt solid var(--ink);border-radius:4pt;padding:8pt;font:800 8pt \"NB Text\",sans-serif;letter-spacing:.1em;\n  background:repeating-linear-gradient(transparent 0 .3in,color-mix(in srgb,var(--ink) 25%,transparent) .3in calc(.3in + .6pt))}\n</style>\n</head>\n<body data-page=\"contents\">\n\n<section data-rules></section>\n\n<section class=\"page\">\n  <h2>{{title}} Score Book</h2>\n  <p class=\"lede\">Write each player's name at the top of a column. Record every game in its row.</p>\n  <table class=\"grid\">\n    <thead><tr><th class=\"r\">GAME</th><th>PLAYER 1</th><th>PLAYER 2</th><th>PLAYER 3</th><th>PLAYER 4</th><th>PLAYER 5</th><th>PLAYER 6</th></tr></thead>\n    <tbody id=\"score-rows\"></tbody>\n    <tfoot><tr><th class=\"r\">TOTAL</th><td></td><td></td><td></td><td></td><td></td><td></td></tr></tfoot>\n  </table>\n</section>\n\n<template data-repeat=\"{{sheets}}\">\n  <section class=\"page sheet\">\n    <div class=\"sheet-head\"><h2>{{title}} · GAME {{n}}</h2><div class=\"fill\"><span>DATE</span><span>WINNER</span></div></div>\n    <table class=\"grid\">\n      <thead><tr><th class=\"r\">ROUND</th><th></th><th></th><th></th><th></th><th></th><th></th></tr></thead>\n      <tbody>\n        <tr><th class=\"r\">1</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">2</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">3</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">4</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">5</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">6</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">7</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">8</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n      </tbody>\n      <tfoot><tr><th class=\"r\">TOTAL</th><td></td><td></td><td></td><td></td><td></td><td></td></tr></tfoot>\n    </table>\n    <div class=\"notes\">NOTES</div>\n  </section>\n</template>\n\n<script>\n// Score Book rows: one per game sheet.\n(function () {\n  const n = 24;\n  let rows = '';\n  for (let r = 1; r <= n; r++) rows += '<tr><th class=\"r\">' + r + '</th>' + '<td></td>'.repeat(6) + '</tr>';\n  document.getElementById('score-rows').innerHTML = rows;\n})();\n</script>\n</body>\n</html>\n","sampler":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"robots\" content=\"noindex\">\n<title>Sampler</title>\n<link rel=\"stylesheet\" href=\"/studio/kit/print.css\">\n<script src=\"/studio/kit/kit.js\"></script>\n<script src=\"/studio/kit/print.js\"></script>\n<!--\n  SAMPLER: the free sampler's own pages, in order. The free sampler PDF is always: the chosen\n  front cover with the SAMPLER stamp, the rules, the scoring pages from contents.html, then these\n  pages. Nothing else. So the rules and scoring pages are not repeated here. Separate from contents.html.\n  - Each <section class=\"page\"> is one fixed page; its padding keeps content in the safe area.\n  - <template data-repeat=\"N\" data-per=\"2\"> repeats its pages N times. Inside it, {{n}} numbers\n    the copies (1, 2, 3...) and {{i}} {{i+1}} number the items on each copy (1-2, 3-4...).\n    {{sheets}} is print.sheets in game.json (set on the admin page).\n  - Filled from game.json: {{title}} {{subtitle}} {{tagline}} {{url}} {{price}} {{sheets}}.\n-->\n<style>\n.page h2{font-size:28pt;color:var(--brand)}\n.page .lede{margin:4pt 0 12pt;font-size:10pt}\n.grid{width:100%;border-collapse:collapse;table-layout:fixed}\n.grid th,.grid td{border:1pt solid var(--ink);height:.3in;font-size:9pt;text-align:center}\n.grid thead th{background:var(--brand);color:#fff;font:400 11pt \"NB Display\",Impact,sans-serif;letter-spacing:.04em;height:.42in}\n.grid th.r{width:.7in;background:color-mix(in srgb,var(--accent) 25%,#fff);color:var(--ink);font:400 11pt \"NB Display\",Impact,sans-serif}\n.grid tfoot th,.grid tfoot td{height:.42in;border-width:2pt}\n\n.sheet{display:flex;flex-direction:column;gap:10pt}\n.sheet-head{display:flex;justify-content:space-between;align-items:baseline;border-bottom:2pt solid var(--ink);padding-bottom:4pt}\n.sheet-head .fill{display:flex;gap:16pt;font:800 8pt \"NB Text\",sans-serif;letter-spacing:.1em}\n.sheet-head .fill span{border-bottom:1pt solid var(--ink);min-width:1.3in}\n.notes{flex:1;border:1pt solid var(--ink);border-radius:4pt;padding:8pt;font:800 8pt \"NB Text\",sans-serif;letter-spacing:.1em;\n  background:repeating-linear-gradient(transparent 0 .3in,color-mix(in srgb,var(--ink) 25%,transparent) .3in calc(.3in + .6pt))}\n</style>\n</head>\n<body data-page=\"contents\">\n\n<template data-repeat=\"1\">\n  <section class=\"page sheet\">\n    <div class=\"sheet-head\"><h2>{{title}} · GAME {{n}}</h2><div class=\"fill\"><span>DATE</span><span>WINNER</span></div></div>\n    <table class=\"grid\">\n      <thead><tr><th class=\"r\">ROUND</th><th></th><th></th><th></th><th></th><th></th><th></th></tr></thead>\n      <tbody>\n        <tr><th class=\"r\">1</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">2</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">3</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">4</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">5</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">6</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">7</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n        <tr><th class=\"r\">8</th><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n      </tbody>\n      <tfoot><tr><th class=\"r\">TOTAL</th><td></td><td></td><td></td><td></td><td></td><td></td></tr></tfoot>\n    </table>\n    <div class=\"notes\">NOTES</div>\n  </section>\n</template>\n\n</body>\n</html>\n","files":{}}