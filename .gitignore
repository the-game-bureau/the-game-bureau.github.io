.env
.env.local
archive/game/lib/.env
archive/game/lib/.env.local
.claude/worktrees/
.claude/settings.local.json
# Both backup folders are listed explicitly. This used to be a bare `backups/`,
# which matched a directory of that name at ANY depth and so covered both of
# them with one line; the paths are anchored now, so a new backup folder is not
# ignored by accident — and neither of these two stops being ignored when one
# of them moves again.
mc/backups/
mc/_dev/backups/

# Generated / temp files
.tmp/
__pycache__/
*.pyc
.tmp_*.js
temp_*.txt
_cache/

# Supabase CLI scratch. `supabase link` and most CLI commands write a .temp/
# holding the linked project ref plus cached Postgres / GoTrue / storage / CLI
# version strings — machine-local state that was committed for months and
# churned in every diff. Untracked 2026-08-07 along with a root-level supabase/
# folder that held nothing else and made running the CLI from the repo root look
# like it had found the project. The real project is mc/supabase/, which is
# where the CLI has to be run from — see CLAUDE.md.
.temp/
