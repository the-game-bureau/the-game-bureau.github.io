        {
          "id": "oswald-s-diary",
          "name": "Oswald\u2019s Diary",
          "links": [],
          "nodes": [
            {
              "x": 0,
              "y": -72,
              "id": "gm-01",
              "body": "On August 9th, 1963, a well traveled 23-year-old man was arrested in New Orleans for disturbing the peace.\n\n3 months later he was arrested in Dallas, and immediately became the presumptive assassin of President John F. Kennedy.\n\n2 days later he too was fatally shot.\n\nThat young man was Lee Oswald.\n\nThose are facts.\n\nFrom here on out, anything you discover may be fact, or it may be fiction.\n\nThat\u2019s for you to decipher.\n\nYou\u2019ve found Oswald\u2019s Diary.\n\nYour mission is to take it to the city where he was born and get it into the right hands before it\u2019s too late.",
              "tags": [
                "Conspiracy",
                "Mystery"
              ],
              "type": "game",
              "price": "Free to Start / $14.99 in game purchase",
              "title": "Oswald\u2019s Diary",
              "width": 184,
              "height": 318,
              "anytime": false,
              "tagline": "Uncover the truth behind New Orleans\u2019 most infamous visitor.",
              "varName": "",
              "rotation": 0,
              "acceptAny": false,
              "guideName": "Jack Martin",
              "orderIndex": 100,
              "builderNotes": "",
              "anytimePairId": ""
            }
