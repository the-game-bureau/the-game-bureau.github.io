        {
          "id": "murder-atlas-new-orleans-edition",
          "name": "Murder Atlas: New Orleans Edition",
          "links": [],
          "nodes": [
            {
              "x": 0,
              "y": -72,
              "id": "gm-01",
              "body": "Every major city in the world has its share of death. New Orleans just made an art form of it. In Murder Atlas: New Orleans Edition, you\u2019ll follow a trail of scandal, mystery, and blood through the city\u2019s shadowy past, where jazz music can literally save your life.\n\nTrack clues, interrogate suspects, and outrun the shadows in a city of jazz, ghosts, and unsolved horrors, where the legend of the Axeman still hangs in the air.\n\nYou must be in New Orleans to start the game.\n\nIf you\u2019re already here, text JAZZ to begin.",
              "tags": [
                "TRUE CRIME",
                "Horror",
                "New Orleans"
              ],
              "type": "game",
              "price": "Free To Start / In App Purchases",
              "title": "Murder Atlas: New Orleans Edition",
