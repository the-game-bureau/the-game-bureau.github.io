{
  "permissions": {
    "allow": [
      "PowerShell(scoop --version 2>&1)",
      "PowerShell(choco --version 2>&1)",
      "PowerShell(choco install supabase -y)",
      "PowerShell($release = Invoke-RestMethod \"https://api.github.com/repos/supabase/cli/releases/latest\"; $release.tag_name)",
      "PowerShell(Test-Path \"$env:USERPROFILE\\\\bin\\\\supabase.exe\")",
      "PowerShell(& \"$env:USERPROFILE\\\\bin\\\\supabase.exe\" --version)"
    ]
  }
}
